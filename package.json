{
  "name": "orvena",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "predev": "npm run build -w @orvena/sdk",
    "dev": "concurrently -k -n web,relayer,dapp \"npm run dev -w @orvena/web\" \"npm run dev -w @orvena/relayer\" \"npm run dev -w @orvena/dapp\"",
    "dev:example": "npm run dev -w @orvena/dapp",
    "dev:api": "npm run dev -w @orvena/relayer",
    "demo": "powershell -NoProfile -File scripts/start-demo.ps1",
    "build": "npm run build -w @orvena/sdk && npm run build -w @orvena/web && npm run build -w @orvena/relayer && node scripts/build-api.mjs && npm run build -w @orvena/dapp",
    "pretypecheck": "npm run build -w @orvena/sdk",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "compile": "npm run compile -w @orvena/contracts",
    "test": "npm run test --workspaces --if-present",
    "check": "npm run typecheck && npm run compile && npm test && npm run build",
    "predoctor": "npm run build -w @orvena/sdk",
    "doctor": "tsx scripts/doctor.ts",
    "chain": "npm run node -w @orvena/contracts",
    "deploy:local": "npm run deploy:local -w @orvena/contracts",
    "deploy:testnet": "npm run deploy:testnet -w @orvena/contracts",
    "deploy:approvals:local": "npm run deploy:approvals:local -w @orvena/contracts",
    "deploy:approvals:testnet": "npm run deploy:approvals:testnet -w @orvena/contracts",
    "setup:local": "npm run deploy:local && npm run deploy:approvals:local && tsx scripts/setup-local.ts",
    "prepare:testnet": "tsx scripts/prepare-testnet.ts",
    "fund:relayer": "tsx scripts/fund-relayer.ts",
    "test:integration": "tsx scripts/approval-integration.ts",
    "verify:testnet": "tsx scripts/verify.ts",
    "dev:local": "tsx scripts/dev-local.ts",
    "test:local": "tsx scripts/approval-integration.ts --local",
    "pack:sdk": "npm run build -w @orvena/sdk && tsx scripts/pack-sdk.ts",
    "start": "node scripts/start.mjs",
    "verify:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "esbuild": "0.28.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
